{
  "info": {
    "name": "CampusConnect Student API",
    "description": "Postman requests for the Student CRUD assignment. Create a record first and use its returned _id for ID-based requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/students"
    },
    {
      "key": "studentId",
      "value": "REPLACE_WITH_REAL_MONGODB_ID"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "http://localhost:5000/"
      }
    },
    {
      "name": "List students (pagination + sort)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}?page=1&limit=5&sort=asc"
      }
    },
    {
      "name": "Search by name or email",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}?search=aarav"
      }
    },
    {
      "name": "Filter by city",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}?city=Surat"
      }
    },
    {
      "name": "Filter by category",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}?category=Backend%20Development"
      }
    },
    {
      "name": "Combined search/filter/sort/pagination",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}?search=example.com&city=Surat&sort=desc&page=1&limit=10"
      }
    },
    {
      "name": "Student statistics (extra)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/stats"
      }
    },
    {
      "name": "Create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Shah\",\n  \"email\": \"aarav.shah@example.com\",\n  \"phone\": \"9876543210\",\n  \"city\": \"Surat\",\n  \"category\": \"Backend Development\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  if (body.data && body.data._id) pm.collectionVariables.set(\"studentId\", body.data._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get student by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/{{studentId}}"
      }
    },
    {
      "name": "Update student",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"city\": \"Ahmedabad\",\n  \"category\": \"Frontend Development\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/{{studentId}}"
      }
    },
    {
      "name": "Delete student",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/{{studentId}}"
      }
    }
  ]
}